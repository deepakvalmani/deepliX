# Environment Variables Configuration for DeepliX
# Copy this file to .env on your local machine or add to environment secrets.

# MongoDB Connection URI (Atlas / Local MongoDB)
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/deeplix?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/deeplix
MONGODB_URI=

# Optional PostgreSQL / SQL Database Connection URI
# Example: postgresql://postgres:password@localhost:5432/deeplix_db
DATABASE_URL=

# Admin Authentication
ADMIN_EMAIL="rajvalmani@gmail.com"
ADMIN_PASSWORD="admin123"

# Node Environment
NODE_ENV="development"
PORT=3000

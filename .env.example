# Email Service Configuration Options

# Option A: Resend API Key (Recommended)
RESEND_API_KEY=
# The verified sender email address in Resend (e.g. notifications@yourdomain.com or onboarding@resend.dev)
SENDER_EMAIL=onboarding@resend.dev
# The email address where you want to receive contact notifications
CONTACT_NOTIFICATION_EMAIL=your-email@example.com

# Option B: Standard SMTP Server (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database Configuration
# MongoDB connection string (e.g., mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=
MONGODB_DB_NAME=deeplix_db
